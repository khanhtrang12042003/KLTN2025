@{
    var title = ViewData["Title"] ?? "Trang nhân sự - Trung tâm Gia sư Amsterdam Bảo Tuân";
    var userName = ViewBag.UserName ?? "Nhân sự trung tâm";
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/nhansu_site.css" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
    <div class="sidebar">
        <div class="logo">
            <img src="~/img/Logo-1.png" alt="Logo Amsterdam" />
            <h5>Nhân sự Bảo Tuân</h5>
        </div>
        <nav>
            <a asp-controller="NhanSu" asp-action="Index"
                class="@(ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">🏠 Dashboard</a>
            <a asp-controller="NhanSu" asp-action="XemHoSoGiaSu"
                class="@(ViewContext.RouteData.Values["action"].ToString() == "DuyetHoSoGiaSu" ? "active" : "")">📋
                Duyệt hồ sơ gia sư</a>
            <a asp-controller="NhanSu" asp-action="QuanLyHopDongChinhSach"
                class="@(ViewContext.RouteData.Values["action"].ToString() == "QuanLyHopDongChinhSach" ? "active" : "")">📑
                Hợp đồng & Chính sách</a>
            <a asp-controller="NhanSu" asp-action="PhanCongLopHoc"
                class="@(ViewContext.RouteData.Values["action"].ToString() == "PhanCongLopHoc" ? "active" : "")">📚 Phân
                công lớp học</a>
        </nav>
        <a asp-controller="TaiKhoan" asp-action="DangNhap" class="text-decoration-none logout-btn">🚪 Đăng xuất</a>
    </div>

    <div class="header">
        <h5>@title</h5>
        <div class="welcome">👋 Xin chào, <strong>@userName</strong></div>
    </div>

    <div class="content">
        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/lib/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>

</html>