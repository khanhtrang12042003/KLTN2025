@{
    ViewData["Title"] = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0 p-4">
                <h3 class="fw-bold text-center text-primary mb-4">Đăng ký tài khoản</h3>

                <form asp-action="DangKy" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ tên</label>
                        <input type="text" name="hoTen" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên đăng nhập</label>
                        <input type="text" name="tenDangNhap" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu</label>
                        <input type="password" name="matKhau" class="form-control" required />
                    </div>

                    <!-- Vai trò -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Bạn là</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="role" id="giaSu" value="GiaSu" required />
                                <label class="form-check-label" for="giaSu">Gia sư</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="role" id="phuHuynh" value="PhuHuynh" />
                                <label class="form-check-label" for="phuHuynh">Phụ huynh</label>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Đăng ký</button>

                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger mt-3 text-center">@ViewBag.ThongBao</div>
                    }

                    <div class="text-center mt-3">
                        <small>Bạn đã có tài khoản? <a asp-action="DangNhap" class="text-decoration-none text-primary fw-semibold">Đăng nhập</a></small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
