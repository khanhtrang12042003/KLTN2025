@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0 p-4">
                <h3 class="fw-bold text-center text-primary mb-4">Đăng nhập</h3>

                <form asp-action="DangNhap" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email hoặc tên đăng nhập</label>
                        <input type="text" name="emailOrUsername" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Đăng nhập với vai trò</label>
                        <select name="role" class="form-select">
                            <option value="GiaSu">Gia sư</option>
                            <option value="PhuHuynh">Phụ huynh</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Đăng nhập</button>

                    @if (ViewBag.ThongBao != null)
                    {
                        <div class="alert alert-danger mt-3 text-center">@ViewBag.ThongBao</div>
                    }

                    <div class="text-center mt-3">
                        <small>Chưa có tài khoản? <a asp-action="DangKy" class="text-decoration-none text-primary fw-semibold">Đăng ký ngay</a></small><br />
                        <small><a asp-action="QuenMatKhau" class="text-decoration-none text-secondary">Quên mật khẩu?</a></small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
